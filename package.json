{
  "name": "bob-plugin-ollama-translator",
  "version": "0.2.0",
  "private": true,
  "description": "A local-only Ollama translation plugin for Bob",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
